# ═══════════════════════════════════════════════════════════════════
# CashLens — Environment Configuration
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cashlens:cashlens@localhost:5432/cashlens

# ── Clerk (Auth) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=

# ── SimpleFIN ──────────────────────────────────────────────────────
# Claim a setup token at https://bridge.simplefin.org/simplefin/create
# Or use a free demo token from https://beta-bridge.simplefin.org/info/developers
SIMPLEFIN_ACCESS_URL=

# ── Teller ─────────────────────────────────────────────────────────
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_CERT_PATH=./certs/teller/certificate.pem
TELLER_KEY_PATH=./certs/teller/private_key.pem

# ── Plaid ──────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Gmail ──────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./creds/gmail_credentials.json
GMAIL_TOKEN_PATH=./creds/gmail_token.pickle

# ── OpenRouter (LLM) ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── VAPID (Push Notifications) ────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Encryption ─────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
