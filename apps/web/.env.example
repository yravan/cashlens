# Copy to .env.local (untracked — never commit real keys).
# Keys: `npx clerk@latest env pull` (the CLI is linked to the "Cash Lens" app)
# or Clerk Dashboard → Cash Lens → API keys. pk_test_/sk_test_ belong to the
# DEVELOPMENT instance; production (leaf 1.3) gets its own instance and keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Local dev database (`pnpm db:up` starts it on 5433; see CLAUDE.md).
# These are fixed local-only dev credentials, not secrets. The app runs as
# cashlens_app (non-owner, RLS-enforced); cashlens_owner runs migrations;
# the superuser URL is used only by `pnpm db:setup` and test fixtures.
DATABASE_URL=postgresql://cashlens_app:cashlens_app_dev@localhost:5433/cashlens
DATABASE_URL_OWNER=postgresql://cashlens_owner:cashlens_owner_dev@localhost:5433/cashlens
DATABASE_URL_SUPERUSER=postgresql://postgres:postgres@localhost:5433/postgres

# Connection-credential encryption keyring (leaf 2.1.2): "id:64-hex-key" entries,
# comma-separated; the FIRST entry encrypts new credentials, the rest still decrypt
# (rotation = prepend a new entry). Generate a key: openssl rand -hex 32
# Optional until a Plaid connection exists; the api test suite generates its own.
CREDENTIAL_ENCRYPTION_KEYS=local:REPLACE_ME_WITH_openssl_rand_-hex_32

# Production only (docs/production.md), unset locally: the app's public origin
# (e.g. https://cashlens.example.com) for Clerk authorizedParties verification.
# APP_ORIGIN=
