# Cash Lens web — environment variables. Copy to .env.local (untracked) and
# fill in the Clerk keys. NEVER commit .env.local.
#
# Getting keys — either:
#   npx clerk@latest env pull        # Clerk CLI, linked to the "Cash Lens" app
# or Clerk Dashboard -> Cash Lens -> Configure -> API keys.
#
# pk_test_/sk_test_ keys belong to the DEVELOPMENT instance. Production uses
# a separate Clerk production instance with pk_live_/sk_live_ keys and its own
# Google OAuth credentials (wired up in leaf 1.3, production deployment).

# Public by design: shipped to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Server-only secret. Never expose with a NEXT_PUBLIC_ prefix, never log it.
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Route configuration — safe to keep exactly as-is.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
