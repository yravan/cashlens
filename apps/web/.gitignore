# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example stays tracked, real keys never do
.env*
!.env.example

# e2e artifacts (Playwright) — .clerk holds credential-grade session state
/test-results/
/playwright-report/
/playwright/.clerk/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
